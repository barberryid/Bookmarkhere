{
  "name": "linkshelf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply linkshelf --local",
    "db:migrate:remote": "wrangler d1 migrations apply linkshelf --remote"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.7.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@cloudflare/workers-types": "^4.20260610.1",
    "@lucide/astro": "^1.17.0",
    "@tailwindcss/postcss": "^4.3.0",
    "astro": "^6.4.5",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.99.0"
  },
  "overrides": {
    "yaml": "^2.9.0"
  }
}
