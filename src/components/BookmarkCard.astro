---
import { ArrowUpRight, GripVertical, Pencil, Star, Trash2 } from "@lucide/astro";
import type { Bookmark } from "@lib/mockData";
import { domainFromUrl } from "@lib/urlNormalize";

type Props = {
  bookmark: Bookmark;
  compact?: boolean;
  searchText?: string;
};

const { bookmark, compact = false, searchText = "" } = Astro.props;
const domain = domainFromUrl(bookmark.url);
const fallbackInitial = bookmark.title.trim().charAt(0).toUpperCase() || domain.charAt(0).toUpperCase();
const searchableText = [bookmark.title, bookmark.url, bookmark.description ?? "", domain, searchText]
  .join(" ")
  .toLowerCase();
---

<article
  data-bookmark-card
  data-search={searchableText}
  class="group relative min-h-[104px] rounded-md border border-[#dce3d8] bg-white p-3 shadow-[0_1px_0_rgba(23,32,27,0.03)] transition hover:-translate-y-0.5 hover:border-[#b8c7b3] hover:shadow-md"
>
  <div class="flex h-full gap-3">
    <a
      href={bookmark.url}
      target="_blank"
      rel="noopener noreferrer"
      class="focus-ring flex min-w-0 flex-1 gap-3 rounded-md"
      aria-label={`Open ${bookmark.title}`}
    >
      <span class="mt-0.5 grid h-9 w-9 shrink-0 place-items-center rounded-md border border-[#dfe6da] bg-[#f3f6ef] text-sm font-semibold text-[#2f6f5e]">
        {
          bookmark.faviconUrl ? (
            <img src={bookmark.faviconUrl} alt="" class="h-5 w-5" loading="lazy" decoding="async" />
          ) : (
            fallbackInitial
          )
        }
      </span>
      <span class="min-w-0">
        <span class="flex items-center gap-1.5">
          <span class="truncate text-sm font-semibold text-[#17201b]">{bookmark.title}</span>
          {bookmark.isFavourite && <Star size={13} class="shrink-0 fill-[#d49b2a] text-[#d49b2a]" />}
        </span>
        <span class="mt-1 block truncate text-xs text-[#627166]">{domain}</span>
        {!compact && bookmark.description && (
          <span class="mt-2 line-clamp-2 block text-xs leading-5 text-[#526258]">{bookmark.description}</span>
        )}
      </span>
    </a>

    <div class="flex shrink-0 flex-col items-center gap-1 opacity-100 sm:opacity-0 sm:transition sm:group-hover:opacity-100 sm:group-focus-within:opacity-100">
      <button type="button" class="focus-ring grid h-7 w-7 place-items-center rounded-md text-[#748176] hover:bg-[#edf2e9] hover:text-[#17201b]" title="Reorder bookmark">
        <GripVertical size={15} />
      </button>
      <button type="button" class="focus-ring grid h-7 w-7 place-items-center rounded-md text-[#748176] hover:bg-[#edf2e9] hover:text-[#17201b]" title="Edit bookmark">
        <Pencil size={14} />
      </button>
      <button type="button" class="focus-ring grid h-7 w-7 place-items-center rounded-md text-[#9b4e47] hover:bg-[#faece8] hover:text-[#7f342e]" title="Delete bookmark">
        <Trash2 size={14} />
      </button>
    </div>
  </div>
  <a
    href={bookmark.url}
    target="_blank"
    rel="noopener noreferrer"
    class="focus-ring absolute bottom-2 right-2 hidden h-7 w-7 place-items-center rounded-md text-[#627166] hover:bg-[#edf2e9] hover:text-[#17201b] lg:grid"
    aria-label={`Open ${bookmark.title} in a new tab`}
  >
    <ArrowUpRight size={15} />
  </a>
</article>
