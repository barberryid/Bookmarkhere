---
import { Link, Plus } from "@lucide/astro";
import type { Category } from "@lib/types";

type Props = {
  categories: Category[];
};

const { categories } = Astro.props;
---

<form id="add-bookmark-form" class="scroll-mt-24 rounded-md border border-[#dfe5da] bg-white p-4 shadow-sm">
  <div class="mb-4 flex items-center justify-between gap-3">
    <div>
      <h2 class="text-base font-semibold text-[#17201b]">Add Bookmark</h2>
      <p class="text-sm text-[#66746a]">Save a link with a clean title and folder.</p>
    </div>
    <span class="grid h-9 w-9 place-items-center rounded-md bg-[#eef4e8] text-[#2f6f5e]">
      <Link size={18} />
    </span>
  </div>

  <div class="grid gap-3">
    <label class="grid gap-1 text-sm font-medium text-[#34443b]">
      Title
      <input id="bookmark-title-input" name="title" required class="focus-ring h-10 rounded-md border border-[#cfd8ca] px-3 font-normal" placeholder="Website name" autocomplete="off" />
    </label>
    <label class="grid gap-1 text-sm font-medium text-[#34443b]">
      URL
      <input name="url" required inputmode="url" class="focus-ring h-10 rounded-md border border-[#cfd8ca] px-3 font-normal" placeholder="https://example.com" autocomplete="off" spellcheck="false" />
    </label>
    <label class="grid gap-1 text-sm font-medium text-[#34443b]">
      Category
      <select name="category_id" class="focus-ring h-10 rounded-md border border-[#cfd8ca] bg-white px-3 font-normal">
        {categories.map((category) => <option value={category.id}>{category.name}</option>)}
      </select>
    </label>
    <label class="grid gap-1 text-sm font-medium text-[#34443b]">
      Description
      <textarea name="description" class="focus-ring min-h-20 rounded-md border border-[#cfd8ca] px-3 py-2 font-normal" placeholder="Optional note"></textarea>
    </label>
  </div>

  <div class="mt-4 flex items-center justify-end gap-3">
    <button type="submit" class="focus-ring inline-flex h-10 items-center gap-2 rounded-md bg-[#2f6f5e] px-4 text-sm font-semibold text-white hover:bg-[#285f51]">
      <Plus size={16} />
      Add
    </button>
  </div>

  <p class="mt-3 hidden rounded-md border border-[#f0c8a2] bg-[#fff8ef] px-3 py-2 text-sm text-[#7a4a19]" data-form-error></p>
</form>
