---
import { Check, Link, Plus } from "@lucide/astro";
import { categories } from "@lib/mockData";
---

<form class="rounded-md border border-[#dfe5da] bg-white p-4 shadow-sm">
  <div class="mb-4 flex items-center justify-between gap-3">
    <div>
      <h2 class="text-base font-semibold text-[#17201b]">Add Bookmark</h2>
      <p class="text-sm text-[#66746a]">Save a link with a clean title and folder.</p>
    </div>
    <span class="grid h-9 w-9 place-items-center rounded-md bg-[#eef4e8] text-[#2f6f5e]">
      <Link size={18} />
    </span>
  </div>

  <div class="grid gap-3">
    <label class="grid gap-1 text-sm font-medium text-[#34443b]">
      Title
      <input class="focus-ring h-10 rounded-md border border-[#cfd8ca] px-3 font-normal" placeholder="Website name" />
    </label>
    <label class="grid gap-1 text-sm font-medium text-[#34443b]">
      URL
      <input class="focus-ring h-10 rounded-md border border-[#cfd8ca] px-3 font-normal" placeholder="https://example.com" />
    </label>
    <label class="grid gap-1 text-sm font-medium text-[#34443b]">
      Category
      <select class="focus-ring h-10 rounded-md border border-[#cfd8ca] bg-white px-3 font-normal">
        {categories.map((category) => <option value={category.id}>{category.name}</option>)}
      </select>
    </label>
    <label class="grid gap-1 text-sm font-medium text-[#34443b]">
      Description
      <textarea class="focus-ring min-h-20 rounded-md border border-[#cfd8ca] px-3 py-2 font-normal" placeholder="Optional note"></textarea>
    </label>
  </div>

  <div class="mt-4 flex items-center justify-between gap-3">
    <p class="text-xs text-[#66746a]">Duplicate URL check ready.</p>
    <button type="button" class="focus-ring inline-flex h-10 items-center gap-2 rounded-md bg-[#2f6f5e] px-4 text-sm font-semibold text-white hover:bg-[#285f51]">
      <Plus size={16} />
      Add
    </button>
  </div>

  <div class="mt-3 hidden rounded-md border border-[#f0c8a2] bg-[#fff8ef] px-3 py-2 text-sm text-[#7a4a19]" data-duplicate-warning>
    <Check size={14} class="mr-1 inline" />
    This URL is already saved.
  </div>
</form>
