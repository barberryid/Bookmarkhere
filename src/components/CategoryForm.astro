---
import { FolderPlus } from "@lucide/astro";
---

<form id="add-category-form" class="scroll-mt-24 rounded-md border border-[#dfe5da] bg-white p-4 shadow-sm">
  <div class="mb-3 flex items-center justify-between gap-3">
    <h2 class="text-base font-semibold text-[#17201b]">Add Category</h2>
    <FolderPlus size={18} class="text-[#2f6f5e]" />
  </div>
  <label class="grid gap-1 text-sm font-medium text-[#34443b]">
    Name
    <input id="category-name-input" name="name" required class="focus-ring h-10 rounded-md border border-[#cfd8ca] px-3 font-normal" placeholder="New folder" autocomplete="off" />
  </label>
  <button type="submit" class="focus-ring mt-3 inline-flex h-10 items-center gap-2 rounded-md border border-[#2f6f5e] bg-white px-4 text-sm font-semibold text-[#2f6f5e] hover:bg-[#eef4e8]">
    <FolderPlus size={16} />
    Create
  </button>
  <p class="mt-3 hidden rounded-md border border-[#f0c8a2] bg-[#fff8ef] px-3 py-2 text-sm text-[#7a4a19]" data-form-error></p>
</form>
