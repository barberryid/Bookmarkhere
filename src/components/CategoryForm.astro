---
import { FolderPlus } from "@lucide/astro";
---

<form class="rounded-md border border-[#dfe5da] bg-white p-4 shadow-sm">
  <div class="mb-3 flex items-center justify-between gap-3">
    <h2 class="text-base font-semibold text-[#17201b]">Add Category</h2>
    <FolderPlus size={18} class="text-[#2f6f5e]" />
  </div>
  <label class="grid gap-1 text-sm font-medium text-[#34443b]">
    Name
    <input class="focus-ring h-10 rounded-md border border-[#cfd8ca] px-3 font-normal" placeholder="New folder" />
  </label>
  <button type="button" class="focus-ring mt-3 inline-flex h-10 items-center gap-2 rounded-md border border-[#2f6f5e] bg-white px-4 text-sm font-semibold text-[#2f6f5e] hover:bg-[#eef4e8]">
    <FolderPlus size={16} />
    Create
  </button>
</form>
