---
import {
  ArrowDown,
  ArrowUp,
  ChevronDown,
  Folder,
  GripVertical,
  Pencil,
  Plus,
  Trash2,
} from "@lucide/astro";
import BookmarkCard from "@components/BookmarkCard.astro";
import EmptyState from "@components/EmptyState.astro";
import type { Bookmark, Category } from "@lib/types";

type Props = {
  category: Category;
  bookmarks?: Bookmark[];
  /** Header count when cards are hydrated client-side (deferred). */
  count?: number;
  /**
   * Short name shown in the heading when the category sits inside a collection
   * group (e.g. "SQL" instead of "Work / SQL"). data-category-name keeps the
   * full name so the API and search still use it.
   */
  displayName?: string;
  /**
   * When true, render an empty grid shell (no cards, no empty state). The
   * client fills the grid from the embedded bookmark JSON. Keeps the
   * server-rendered HTML small enough to stay within Worker limits.
   */
  deferred?: boolean;
  /**
   * Hide the whole section (and its rail entry) while it has no bookmarks.
   * Used for the Uncategorised fallback bucket so it only appears when a
   * deleted category's bookmarks land in it.
   */
  hideWhenEmpty?: boolean;
};

const { category, bookmarks = [], deferred = false, hideWhenEmpty = false } = Astro.props;
const count = Astro.props.count ?? bookmarks.length;
const displayName = Astro.props.displayName ?? category.name;
---

<section
  data-category-section
  data-category-id={category.id}
  data-category-name={category.name}
  id={`category-${category.id}`}
  data-hide-when-empty={hideWhenEmpty ? "" : null}
  style="border-left-color: var(--cat, var(--color-accent))"
  class:list={[
    "tile group/tile relative scroll-mt-32 overflow-hidden rounded-lg border border-edge border-l-[3px] bg-surface shadow-card",
    hideWhenEmpty && count === 0 && "hidden",
  ]}
>
  <div class="flex items-center gap-1">
    <h2 class="contents">
      <button
        type="button"
        data-collapse-category
        aria-expanded="true"
        class="focus-ring flex min-w-0 flex-1 items-center gap-2.5 px-3 py-2.5 text-left hover:bg-surface-2/70"
      >
        <ChevronDown size={15} class="shrink-0 text-ink-faint transition-transform" />
        <span
          class="grid h-8 w-8 shrink-0 place-items-center rounded-md"
          style="color: var(--cat, var(--color-accent)); background: color-mix(in srgb, var(--cat, var(--color-accent)) 14%, transparent)"
        >
          <Folder size={16} />
        </span>
        <span class="min-w-0 flex-1">
          <span data-category-title class="block truncate text-sm font-semibold text-ink" title={displayName}>{displayName}</span>
          <span data-category-count data-total={count} class="block truncate text-xs text-ink-mute tabular-nums">
            {count} {count === 1 ? "bookmark" : "bookmarks"}
          </span>
        </span>
      </button>
    </h2>

    <div class="relative z-10 flex shrink-0 items-center gap-0.5 pr-2 opacity-100 transition sm:opacity-0 sm:group-hover/tile:opacity-100 sm:group-focus-within/tile:opacity-100">
      <button
        type="button"
        data-category-grip
        class="hidden cursor-grab touch-none place-items-center text-ink-faint hover:text-ink-mute sm:grid sm:h-7 sm:w-7"
        title="Drag to reorder category"
        aria-label="Drag to reorder category"
        draggable="true"
      >
        <GripVertical size={14} />
      </button>
      <button type="button" data-move-category="up" class="focus-ring grid h-7 w-7 place-items-center rounded-md text-ink-mute hover:bg-surface-2 hover:text-ink" title="Move category up" aria-label="Move category up">
        <ArrowUp size={14} />
      </button>
      <button type="button" data-move-category="down" class="focus-ring grid h-7 w-7 place-items-center rounded-md text-ink-mute hover:bg-surface-2 hover:text-ink" title="Move category down" aria-label="Move category down">
        <ArrowDown size={14} />
      </button>
      <button type="button" data-add-to-category={category.id} class="focus-ring grid h-7 w-7 place-items-center rounded-md text-ink-mute hover:bg-surface-2 hover:text-ink" title="Add bookmark to category" aria-label="Add bookmark to category">
        <Plus size={15} />
      </button>
      <button type="button" data-rename-category class="focus-ring grid h-7 w-7 place-items-center rounded-md text-ink-mute hover:bg-surface-2 hover:text-ink" title="Rename category" aria-label="Rename category">
        <Pencil size={14} />
      </button>
      <button type="button" data-delete-category class="focus-ring grid h-7 w-7 place-items-center rounded-md text-danger hover:bg-danger-soft hover:text-danger-strong" title="Delete category" aria-label="Delete category">
        <Trash2 size={14} />
      </button>
    </div>
  </div>

  <div data-category-body class="border-t border-edge p-3">
    <div
      data-category-grid
      class:list={[
        "grid grid-cols-1 items-start gap-3 md:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4",
        !deferred && !bookmarks.length && "hidden",
      ]}
    >
      {bookmarks.map((bookmark) => <BookmarkCard bookmark={bookmark} searchText={category.name} />)}
    </div>
    <div data-category-empty class:list={[(deferred || bookmarks.length) && "hidden"]}>
      <EmptyState title="No bookmarks here yet." message="Add a bookmark or move one into this category." compact />
    </div>
  </div>
</section>
