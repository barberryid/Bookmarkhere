---
import {
  ArrowDown,
  ArrowUp,
  ChevronDown,
  Folder,
  GripVertical,
  Pencil,
  Plus,
  Trash2,
} from "@lucide/astro";
import BookmarkCard from "@components/BookmarkCard.astro";
import EmptyState from "@components/EmptyState.astro";
import type { Bookmark, Category } from "@lib/types";

type Props = {
  category: Category;
  bookmarks?: Bookmark[];
  /** Header count when cards are hydrated client-side (deferred). */
  count?: number;
  /**
   * When true, render an empty grid shell (no cards, no empty state). The
   * client fills the grid from the embedded bookmark JSON. Keeps the
   * server-rendered HTML small enough to stay within Worker limits.
   */
  deferred?: boolean;
};

const { category, bookmarks = [], deferred = false } = Astro.props;
const count = Astro.props.count ?? bookmarks.length;
---

<section
  data-category-section
  data-category-id={category.id}
  data-category-name={category.name}
  id={`category-${category.id}`}
  class="scroll-mt-32 rounded-lg border border-edge bg-surface-2 p-4 shadow-card"
>
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <div class="flex min-w-0 items-center gap-2">
      <button
        type="button"
        data-category-grip
        class="hidden cursor-grab touch-none text-ink-faint hover:text-ink-mute sm:block"
        title="Drag to reorder category"
        aria-label="Drag to reorder category"
        draggable="true"
      >
        <GripVertical size={15} />
      </button>
      <span class="grid h-8 w-8 place-items-center rounded-md bg-accent-soft text-accent">
        <Folder size={17} />
      </span>
      <div class="min-w-0">
        <h2 data-category-title class="truncate text-base font-semibold text-ink">{category.name}</h2>
        <p data-category-count data-total={count} class="text-xs text-ink-mute tabular-nums">
          {count} {count === 1 ? "bookmark" : "bookmarks"}
        </p>
      </div>
    </div>

    <div class="flex items-center gap-1">
      <button type="button" data-collapse-category aria-expanded="true" class="focus-ring grid h-8 w-8 place-items-center rounded-md border border-edge bg-surface text-ink-mute hover:border-edge-strong" title="Collapse or expand category" aria-label="Collapse or expand category">
        <ChevronDown size={15} class="transition-transform" />
      </button>
      <button type="button" data-move-category="up" class="focus-ring grid h-8 w-8 place-items-center rounded-md border border-edge bg-surface text-ink-mute hover:border-edge-strong" title="Move category up" aria-label="Move category up">
        <ArrowUp size={14} />
      </button>
      <button type="button" data-move-category="down" class="focus-ring grid h-8 w-8 place-items-center rounded-md border border-edge bg-surface text-ink-mute hover:border-edge-strong" title="Move category down" aria-label="Move category down">
        <ArrowDown size={14} />
      </button>
      <button type="button" data-add-to-category={category.id} class="focus-ring grid h-8 w-8 place-items-center rounded-md border border-edge bg-surface text-ink-mute hover:border-edge-strong" title="Add bookmark to category" aria-label="Add bookmark to category">
        <Plus size={15} />
      </button>
      <button type="button" data-rename-category class="focus-ring grid h-8 w-8 place-items-center rounded-md border border-edge bg-surface text-ink-mute hover:border-edge-strong" title="Rename category" aria-label="Rename category">
        <Pencil size={14} />
      </button>
      <button type="button" data-delete-category class="focus-ring grid h-8 w-8 place-items-center rounded-md border border-danger/30 bg-surface text-danger hover:border-danger/60 hover:bg-danger-soft" title="Delete category" aria-label="Delete category">
        <Trash2 size={14} />
      </button>
    </div>
  </div>

  <div data-category-body>
    <div
      data-category-grid
      class:list={[
        "grid grid-cols-1 items-start gap-3 md:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4",
        !deferred && !bookmarks.length && "hidden",
      ]}
    >
      {bookmarks.map((bookmark) => <BookmarkCard bookmark={bookmark} searchText={category.name} />)}
    </div>
    <div data-category-empty class:list={[(deferred || bookmarks.length) && "hidden"]}>
      <EmptyState title="No bookmarks here yet." message="Add a bookmark or move one into this category." compact />
    </div>
  </div>
</section>
