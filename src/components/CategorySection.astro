---
import { ChevronDown, ChevronUp, Folder, Pencil, Plus, Trash2 } from "@lucide/astro";
import BookmarkCard from "@components/BookmarkCard.astro";
import EmptyState from "@components/EmptyState.astro";
import type { Bookmark, Category } from "@lib/mockData";

type Props = {
  category: Category;
  bookmarks: Bookmark[];
};

const { category, bookmarks } = Astro.props;
---

<section data-category-section data-category-name={category.name} class="rounded-md border border-[#dfe5da] bg-[#fbfcf7] p-4 shadow-sm">
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <div class="flex min-w-0 items-center gap-2">
      <span class="grid h-8 w-8 place-items-center rounded-md bg-[#e9f0e3] text-[#2f6f5e]">
        <Folder size={17} />
      </span>
      <div class="min-w-0">
        <h2 class="truncate text-base font-semibold text-[#17201b]">{category.name}</h2>
        <p class="text-xs text-[#69776c]">{bookmarks.length} {bookmarks.length === 1 ? "bookmark" : "bookmarks"}</p>
      </div>
    </div>

    <div class="flex items-center gap-1">
      <button type="button" class="focus-ring grid h-8 w-8 place-items-center rounded-md border border-[#dfe5da] bg-white text-[#617068] hover:border-[#b8c7b3]" title="Move category up">
        <ChevronUp size={15} />
      </button>
      <button type="button" class="focus-ring grid h-8 w-8 place-items-center rounded-md border border-[#dfe5da] bg-white text-[#617068] hover:border-[#b8c7b3]" title="Move category down">
        <ChevronDown size={15} />
      </button>
      <button type="button" data-open-form="#add-bookmark-form" data-focus-input="#bookmark-title-input" class="focus-ring grid h-8 w-8 place-items-center rounded-md border border-[#dfe5da] bg-white text-[#617068] hover:border-[#b8c7b3]" title="Add bookmark to category">
        <Plus size={15} />
      </button>
      <button type="button" class="focus-ring grid h-8 w-8 place-items-center rounded-md border border-[#dfe5da] bg-white text-[#617068] hover:border-[#b8c7b3]" title="Rename category">
        <Pencil size={14} />
      </button>
      <button type="button" class="focus-ring grid h-8 w-8 place-items-center rounded-md border border-[#efd8d4] bg-white text-[#9b4e47] hover:border-[#e9aaa0] hover:bg-[#fff7f4]" title="Delete category">
        <Trash2 size={14} />
      </button>
    </div>
  </div>

  {
    bookmarks.length ? (
      <div class="grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-3">
        {bookmarks.map((bookmark) => <BookmarkCard bookmark={bookmark} searchText={category.name} />)}
      </div>
      <div data-category-empty class="hidden">
        <EmptyState title="No bookmarks here yet." message="Add a bookmark or move one into this category." compact />
      </div>
    ) : (
      <div data-category-empty>
        <EmptyState title="No bookmarks here yet." message="Add a bookmark or move one into this category." compact />
      </div>
    )
  }
</section>
