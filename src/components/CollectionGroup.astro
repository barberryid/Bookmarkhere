---
import { Archive, BookOpen, Briefcase, Camera, ChevronDown, Layers, Map } from "@lucide/astro";
import CategorySection from "@components/CategorySection.astro";
import { collectionStyle } from "@lib/collections";
import type { Category } from "@lib/types";

type Props = {
  name: string;
  slug: string;
  count: number;
  categories: Array<{ category: Category; short: string; count: number }>;
};

const { name, slug, count, categories } = Astro.props;
const style = collectionStyle(name);

const ICONS = { Archive, BookOpen, Briefcase, Camera, Layers, Map } as const;
const Icon = ICONS[style.icon as keyof typeof ICONS] ?? Layers;
---

<section
  data-collection
  data-collection-name={name}
  id={`collection-${slug}`}
  style={`--cat: var(${style.colorVar})`}
  class="scroll-mt-32 overflow-hidden rounded-xl border border-edge bg-surface-2/60"
>
  <header
    class="flex items-center gap-3 border-l-2 px-3 py-2.5 sm:px-4"
    style="border-color: var(--cat)"
  >
    <button
      type="button"
      data-collapse-collection
      aria-expanded="true"
      class="focus-ring grid h-8 w-8 shrink-0 place-items-center rounded-md text-ink-mute hover:bg-surface hover:text-ink"
      title="Collapse or expand collection"
      aria-label="Collapse or expand collection"
    >
      <ChevronDown size={18} class="transition-transform" />
    </button>
    <span
      class="grid h-8 w-8 shrink-0 place-items-center rounded-md"
      style="color: var(--cat); background: color-mix(in srgb, var(--cat) 16%, transparent)"
    >
      <Icon size={17} />
    </span>
    <h2 class="min-w-0 flex-1 truncate text-lg font-semibold tracking-tight text-ink">{name}</h2>
    <span data-collection-count class="shrink-0 rounded-full bg-surface px-2 py-0.5 text-xs font-medium text-ink-mute tabular-nums">
      {categories.length} {categories.length === 1 ? "category" : "categories"} · {count}
    </span>
  </header>

  <div data-collection-body class="grid gap-4 p-3 sm:p-4">
    {
      categories.map(({ category, short, count }) => (
        <CategorySection category={category} displayName={short} count={count} deferred />
      ))
    }
  </div>
</section>
