---
import { Archive, BookOpen, Briefcase, Camera, ChevronDown, Layers, Map } from "@lucide/astro";
import CategorySection from "@components/CategorySection.astro";
import { collectionStyle } from "@lib/collections";
import type { Category } from "@lib/types";

type Props = {
  name: string;
  slug: string;
  count: number;
  categories: Array<{ category: Category; short: string; count: number }>;
};

const { name, slug, count, categories } = Astro.props;
const style = collectionStyle(name);

const ICONS = { Archive, BookOpen, Briefcase, Camera, Layers, Map } as const;
const Icon = ICONS[style.icon as keyof typeof ICONS] ?? Layers;
---

<section
  data-collection
  data-collection-name={name}
  id={`collection-${slug}`}
  style={`--cat: var(${style.colorVar}); border-left-color: var(--cat)`}
  class="tile group/tile relative scroll-mt-32 overflow-hidden rounded-xl border border-edge border-l-[3px] bg-surface-2/60"
>
  <h2 class="contents">
    <button
      type="button"
      data-collapse-collection
      aria-expanded="true"
      class="focus-ring flex w-full items-center gap-2.5 px-3 py-2.5 text-left hover:bg-surface/50"
    >
      <ChevronDown size={16} class="shrink-0 text-ink-faint transition-transform" />
      <span
        class="grid h-8 w-8 shrink-0 place-items-center rounded-md"
        style="color: var(--cat); background: color-mix(in srgb, var(--cat) 16%, transparent)"
      >
        <Icon size={16} />
      </span>
      <span class="min-w-0 flex-1">
        <span class="block truncate text-sm font-semibold tracking-tight text-ink" title={name}>{name}</span>
        <span data-collection-count class="block truncate text-xs text-ink-mute tabular-nums">
          {categories.length} {categories.length === 1 ? "category" : "categories"} · {count}
        </span>
      </span>
    </button>
  </h2>

  <div data-collection-body class="grid gap-2.5 border-t border-edge p-2.5 sm:p-3">
    {
      categories.map(({ category, short, count }) => (
        <CategorySection category={category} displayName={short} count={count} deferred />
      ))
    }
  </div>
</section>
