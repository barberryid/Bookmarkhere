---
import { SearchX } from "@lucide/astro";

type Props = {
  title?: string;
  message?: string;
  compact?: boolean;
};

const {
  title = "No bookmarks found",
  message = "Try a different search term or add a new bookmark.",
  compact = false,
} = Astro.props;
---

<div
  class:list={[
    "rounded-xl border border-edge bg-surface text-center shadow-card",
    compact ? "p-6" : "p-10",
  ]}
>
  <span
    class:list={[
      "mx-auto grid place-items-center rounded-full bg-accent-soft text-accent",
      compact ? "h-10 w-10" : "h-12 w-12",
    ]}
  >
    <SearchX size={compact ? 18 : 22} />
  </span>
  <h2 class="mt-3 text-balance text-base font-semibold text-ink">{title}</h2>
  <p class="mx-auto mt-1 max-w-md text-pretty text-sm leading-6 text-ink-mute">{message}</p>
  <slot />
</div>
