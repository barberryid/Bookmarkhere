---
import { SearchX } from "@lucide/astro";

type Props = {
  title?: string;
  message?: string;
  compact?: boolean;
};

const {
  title = "No bookmarks found.",
  message = "Try a different search term or add a new bookmark.",
  compact = false,
} = Astro.props;
---

<div class:list={["rounded-lg border border-dashed border-edge-strong bg-surface text-center", compact ? "p-5" : "p-8"]}>
  <SearchX size={compact ? 20 : 26} class="mx-auto text-ink-faint" />
  <h2 class="mt-3 text-sm font-semibold text-ink">{title}</h2>
  <p class="mx-auto mt-1 max-w-md text-sm leading-6 text-ink-mute">{message}</p>
  <slot />
</div>
