---
import { Download } from "@lucide/astro";

type Props = {
  format?: "json" | "csv";
};

const { format = "json" } = Astro.props;
const label = format === "json" ? "Export JSON" : "Export CSV";
---

<a
  href={`/api/export/${format}`}
  data-export-link
  class="focus-ring inline-flex h-10 items-center gap-2 rounded-md border border-edge bg-surface px-3 text-sm font-medium text-ink-mute shadow-card transition hover:border-edge-strong hover:bg-surface-2 hover:text-ink"
>
  <Download size={16} />
  {label}
</a>
