---
import { Archive, LayoutDashboard, Plus } from "@lucide/astro";
import { productConfig } from "@lib/config";

type Props = {
  active?: "home" | "dashboard";
};

const { active = "home" } = Astro.props;
---

<header class="border-b border-[#dfe4d7] bg-[#fbfcf7]/90 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
    <a href="/" class="focus-ring flex items-center gap-2 rounded-md" aria-label={`${productConfig.appName} home`}>
      <span class="grid h-9 w-9 place-items-center rounded-md border border-[#bfcbbb] bg-[#eef4e8] text-[#2f6f5e]">
        <Archive size={19} stroke-width={2.2} />
      </span>
      <span class="text-lg font-semibold tracking-normal">{productConfig.appName}</span>
    </a>

    <nav class="flex items-center gap-2" aria-label="Primary">
      <a
        href="/dashboard"
        class:list={[
          "focus-ring inline-flex h-9 items-center gap-2 rounded-md px-3 text-sm font-medium transition",
          active === "dashboard"
            ? "bg-[#17201b] text-white"
            : "border border-[#dfe4d7] bg-white text-[#314138] hover:border-[#b7c5b4]",
        ]}
      >
        <LayoutDashboard size={16} />
        Dashboard
      </a>
      <button
        type="button"
        class="focus-ring hidden h-9 items-center gap-2 rounded-md border border-[#2f6f5e] bg-[#2f6f5e] px-3 text-sm font-medium text-white shadow-sm transition hover:bg-[#285f51] sm:inline-flex"
        title="Add bookmark"
      >
        <Plus size={16} />
        Add
      </button>
    </nav>
  </div>
</header>
