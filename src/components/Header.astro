---
import { LayoutDashboard, Moon, Plus, Sun, Vault } from "@lucide/astro";
import { productConfig } from "@lib/config";

type Props = {
  active?: "home" | "dashboard";
};

const { active = "home" } = Astro.props;
---

<header class="border-b border-edge bg-surface/80 backdrop-blur-xl">
  <div class="mx-auto flex max-w-[100rem] items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
    <a href="/" class="focus-ring flex items-center gap-2.5 rounded-md" aria-label={`${productConfig.appName} home`}>
      <span class="grid h-9 w-9 place-items-center rounded-lg text-accent-ink shadow-sm" style="background: var(--grad-vault)">
        <Vault size={19} stroke-width={2.1} />
      </span>
      <span class="text-lg font-semibold tracking-tight">{productConfig.appName}</span>
    </a>

    <nav class="flex items-center gap-2" aria-label="Primary">
      <a
        href="/dashboard"
        class:list={[
          "focus-ring inline-flex h-9 items-center gap-2 rounded-md px-3 text-sm font-medium transition",
          active === "dashboard"
            ? "bg-ink text-canvas"
            : "border border-edge bg-surface text-ink-mute hover:border-edge-strong",
        ]}
      >
        <LayoutDashboard size={16} />
        Dashboard
      </a>
      {
        active === "dashboard" ? (
          <button
            type="button"
            data-open-add-bookmark
            class="btn-vault focus-ring hidden h-9 items-center gap-2 rounded-md px-3 text-sm shadow-sm sm:inline-flex"
            title="Add bookmark (a)"
          >
            <Plus size={16} />
            Add
          </button>
        ) : (
          <a
            href="/dashboard"
            class="btn-vault focus-ring hidden h-9 items-center gap-2 rounded-md px-3 text-sm shadow-sm sm:inline-flex"
            title="Add bookmark"
          >
            <Plus size={16} />
            Add
          </a>
        )
      }
      <button
        type="button"
        data-theme-toggle
        class="focus-ring grid h-9 w-9 place-items-center rounded-md border border-edge bg-surface text-ink-mute transition hover:border-edge-strong hover:text-ink"
        aria-label="Toggle theme"
      >
        <Sun size={16} class="theme-icon theme-icon-light" />
        <Moon size={16} class="theme-icon theme-icon-dark" />
      </button>
    </nav>
  </div>
</header>

<script>
  import { initTheme } from "../scripts/theme";
  initTheme();
</script>
