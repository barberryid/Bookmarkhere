---
import { Search, X } from "@lucide/astro";

type Props = {
  value?: string;
  placeholder?: string;
};

const { value = "", placeholder = "Search title, URL, description, category, or tag" } = Astro.props;
---

<form class="relative w-full" role="search">
  <label for="bookmark-search" class="sr-only">Search bookmarks</label>
  <Search class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-ink-mute" size={20} />
  <input
    id="bookmark-search"
    name="search"
    value={value}
    placeholder={placeholder}
    class="search-field focus-ring h-12 w-full rounded-lg border border-edge-strong bg-surface pl-12 pr-12 text-base shadow-card outline-none transition placeholder:text-ink-faint"
    autocomplete="off"
  />
  <button
    type="button"
    data-search-clear
    class:list={[
      "focus-ring absolute right-3 top-1/2 grid h-8 w-8 -translate-y-1/2 place-items-center rounded-md text-ink-mute hover:bg-surface-2 hover:text-ink",
      !value && "hidden",
    ]}
    aria-label="Clear search"
  >
    <X size={17} />
  </button>
  <p class="pointer-events-none mt-1.5 hidden text-xs text-ink-faint sm:block">
    Press <kbd class="rounded border border-edge bg-surface px-1 font-sans">/</kbd> to search ·
    <kbd class="rounded border border-edge bg-surface px-1 font-sans">Ctrl K</kbd> for the palette ·
    <kbd class="rounded border border-edge bg-surface px-1 font-sans">?</kbd> for shortcuts
  </p>
</form>
