---
import "../styles/global.css";
import { productConfig } from "@lib/config";

type Props = {
  title?: string;
  description?: string;
  noindex?: boolean;
};

const {
  title = productConfig.appName,
  description = "A fast, visual bookmark manager for keeping favourite websites easy to find.",
  noindex = false,
} = Astro.props;

const pageTitle = title === productConfig.appName ? title : `${title} | ${productConfig.appName}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/InterVariable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{pageTitle}</title>
    <script is:inline>
      // Apply the saved theme before first paint to avoid a flash.
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem("linkshelf-theme");
        } catch {}
        const theme = stored === "light" || stored === "dark" ? stored : "system";
        const dark =
          theme === "dark" ||
          (theme === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.classList.toggle("dark", dark);
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body class="min-h-screen bg-canvas text-ink antialiased">
    <slot />
  </body>
</html>
