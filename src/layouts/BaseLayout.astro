---
import "../styles/global.css";
import { productConfig } from "@lib/config";

type Props = {
  title?: string;
  description?: string;
};

const {
  title = productConfig.appName,
  description = "A fast, visual bookmark manager for keeping favourite websites easy to find.",
} = Astro.props;

const pageTitle = title === productConfig.appName ? title : `${title} | ${productConfig.appName}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen bg-[#f7f8f3] text-[#17201b] antialiased">
    <slot />
  </body>
</html>
