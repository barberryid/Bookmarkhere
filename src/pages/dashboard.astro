---
import { ChevronDown, ChevronsDownUp, ChevronsUpDown, FileUp, LayoutGrid, List, PanelLeft, Plus, Sparkles, Star, X } from "@lucide/astro";
import BookmarkCard from "@components/BookmarkCard.astro";
import BookmarkDialog from "@components/BookmarkDialog.astro";
import CategorySection from "@components/CategorySection.astro";
import CollectionGroup from "@components/CollectionGroup.astro";
import CommandPalette from "@components/CommandPalette.astro";
import ConfirmDialog from "@components/ConfirmDialog.astro";
import EmptyState from "@components/EmptyState.astro";
import ExportButton from "@components/ExportButton.astro";
import Header from "@components/Header.astro";
import ImportPanel from "@components/ImportPanel.astro";
import SearchBar from "@components/SearchBar.astro";
import ShortcutCheatsheet from "@components/ShortcutCheatsheet.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getPrivateUserId } from "@lib/auth";
import { listBookmarks } from "@lib/bookmarks";
import { listCategories } from "@lib/categories";
import { groupByCollection } from "@lib/collections";
import { getDb, uncategorisedCategoryId } from "@lib/db";
import { loadUsage, rankMostUsed } from "@lib/mostUsed";
import type { Bookmark, Category } from "@lib/types";

export const prerender = false;

const db = getDb();
const userId = getPrivateUserId();

const [categories, bookmarks] = await Promise.all([
  listCategories(db, userId),
  listBookmarks(db, userId),
]);

const ordered = [...bookmarks].sort(
  (a, b) =>
    a.categoryId.localeCompare(b.categoryId) ||
    a.sortOrder - b.sortOrder ||
    a.title.localeCompare(b.title),
);

const countByCategory = new Map<string, number>();
for (const bookmark of bookmarks) {
  countByCategory.set(bookmark.categoryId, (countByCategory.get(bookmark.categoryId) ?? 0) + 1);
}

const collectionGroups = groupByCollection(categories, countByCategory);

const favouriteCount = bookmarks.filter((bookmark) => bookmark.isFavourite).length;

// "Most Used" is generated, not a stored category: rank favourites + tracked
// opens server-side (cheap — just ids) and let the client build those cards.
const usage = await loadUsage(db, userId);
const mostUsedIds = rankMostUsed(bookmarks, usage);
const mostUsedJson = JSON.stringify(mostUsedIds).replace(/</g, "\\u003c");

// Cards are built on the client from this compact payload. Rendering 2,000+
// cards server-side blows the Worker CPU/memory budget (Error 1102); a JSON
// blob keeps the response small and the render cheap. Short keys shrink it
// further. The "<" escape keeps the closing </script> tag safe.
const bookmarkData = ordered.map((bookmark) => ({
  i: bookmark.id,
  t: bookmark.title,
  u: bookmark.url,
  c: bookmark.categoryId,
  d: bookmark.description ?? "",
  f: bookmark.isFavourite ? 1 : 0,
}));
const bookmarkJson = JSON.stringify(bookmarkData).replace(/</g, "\\u003c");

const totalBookmarks = bookmarks.length;
// The empty Uncategorised fallback bucket is hidden, so don't count it.
const totalCategories = categories.filter(
  (category) =>
    !(category.id === uncategorisedCategoryId && (countByCategory.get(category.id) ?? 0) === 0),
).length;

// Empty objects used only to stamp out client-side templates.
const emptyBookmark: Bookmark = {
  id: "",
  userId,
  categoryId: "",
  title: "",
  url: "",
  description: "",
  faviconUrl: undefined,
  sortOrder: 0,
  isFavourite: false,
  createdAt: "",
  updatedAt: "",
};
const emptyCategory: Category = {
  id: "",
  userId,
  name: "",
  slug: "",
  sortOrder: 0,
  createdAt: "",
  updatedAt: "",
};
---

<BaseLayout title="Dashboard" noindex>
  <Header active="dashboard" />

  <main
    class="mx-auto max-w-[100rem] px-4 py-6 sm:px-6 lg:px-8"
    data-uncategorised-id={uncategorisedCategoryId}
  >
    <section class="mb-5 flex flex-wrap items-center justify-between gap-3">
      <div>
        <h1 class="text-balance text-3xl font-bold tracking-tight text-ink">My Bookmark Vault</h1>
        <p class="mt-1.5 text-sm text-ink-mute">
          <span data-total-count class="font-medium tabular-nums text-ink">{totalBookmarks.toLocaleString()}</span> saved links across
          <span data-category-total class="font-medium tabular-nums text-ink">{totalCategories.toLocaleString()}</span> categories<span data-search-summary class="hidden"> · <span data-visible-count class="tabular-nums">{totalBookmarks}</span> matching</span>
        </p>
        <p class="mt-0.5 text-sm text-ink-faint">Search, organise, and maintain your saved web.</p>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <button
          type="button"
          data-open-add-bookmark
          class="btn-vault focus-ring inline-flex h-10 items-center gap-2 rounded-md px-3.5 text-sm shadow-sm"
        >
          <Plus size={16} />
          Add Bookmark
        </button>
        <a
          href="/import"
          class="focus-ring inline-flex h-10 items-center gap-2 rounded-md border border-edge bg-surface px-3 text-sm font-medium text-ink-mute shadow-card hover:border-edge-strong hover:text-ink"
        >
          <FileUp size={16} />
          Import
        </a>
        <ExportButton format="json" />
        <ExportButton format="csv" />
        <button
          type="button"
          data-collapse-all
          aria-pressed="true"
          class="focus-ring grid h-10 w-10 place-items-center rounded-md border border-edge bg-surface text-ink-mute shadow-card hover:border-edge-strong hover:text-ink"
          title="Collapse all"
          aria-label="Collapse all categories"
        >
          <ChevronsDownUp size={16} class="collapse-all-fold" />
          <ChevronsUpDown size={16} class="collapse-all-unfold hidden" />
        </button>
        <button
          type="button"
          data-density-toggle
          aria-pressed="false"
          class="focus-ring grid h-10 w-10 place-items-center rounded-md border border-edge bg-surface text-ink-mute shadow-card hover:border-edge-strong hover:text-ink"
          title="Toggle density"
        >
          <LayoutGrid size={16} class="density-icon-grid" />
          <List size={16} class="density-icon-compact hidden" />
        </button>
      </div>
    </section>

    <section class="sticky top-0 z-20 -mx-4 border-y border-edge bg-canvas/95 px-4 py-4 backdrop-blur sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8">
      <div class="flex items-center gap-2">
        <button
          type="button"
          data-rail-toggle
          class="focus-ring grid h-12 w-12 shrink-0 place-items-center rounded-lg border border-edge-strong bg-surface text-ink-mute shadow-card hover:text-ink lg:hidden"
          aria-label="Browse categories"
        >
          <PanelLeft size={18} />
        </button>
        <div class="min-w-0 flex-1">
          <SearchBar />
        </div>
      </div>
    </section>

    {
      totalBookmarks === 0 ? (
        <div class="mt-8 grid gap-6 lg:grid-cols-[minmax(0,1fr)_360px]">
          <EmptyState title="No bookmarks yet." message="Add your first bookmark, or import a Booky export to get started." >
            <button
              type="button"
              data-open-add-bookmark
              class="focus-ring mt-4 inline-flex h-10 items-center gap-2 rounded-md bg-accent px-4 text-sm font-semibold text-accent-ink hover:bg-accent-strong"
            >
              <Plus size={16} />
              Add a bookmark
            </button>
          </EmptyState>
          <ImportPanel />
        </div>
      ) : (
        <div class="mt-6 grid gap-6 lg:grid-cols-[220px_minmax(0,1fr)]">
          <div data-rail-backdrop class="rail-backdrop fixed inset-0 z-30 bg-black/50 lg:hidden"></div>
          <aside
            data-rail-aside
            class="rail-aside fixed inset-y-0 left-0 z-40 w-72 max-w-[82vw] overflow-y-auto border-r border-edge bg-surface p-4 transition-transform duration-200 lg:static lg:z-auto lg:w-auto lg:max-w-none lg:overflow-visible lg:border-0 lg:bg-transparent lg:p-0"
          >
            <nav
              data-category-rail
              aria-label="Categories"
              class="lg:sticky lg:top-28 lg:max-h-[calc(100vh-8rem)] lg:overflow-y-auto lg:pr-1 text-sm"
            >
              <div class="mb-2 flex items-center justify-between px-2">
                <p class="text-xs font-semibold uppercase tracking-wide text-ink-faint">Categories</p>
                <button
                  type="button"
                  data-rail-close
                  class="focus-ring grid h-7 w-7 place-items-center rounded-md text-ink-mute hover:bg-surface-2 hover:text-ink lg:hidden"
                  aria-label="Close categories"
                >
                  <X size={16} />
                </button>
              </div>
              <div data-rail-list class="grid gap-0.5" />
            </nav>
          </aside>

          <div class="grid content-start gap-5">
            <section
              data-most-used
              id="most-used"
              data-density="compact"
              style="--cat: var(--color-cat-gold); border-left-color: var(--cat)"
              class:list={[
                "scroll-mt-32 rounded-lg border border-edge border-l-[3px] bg-surface-2 p-4 shadow-card",
                mostUsedIds.length === 0 && "hidden",
              ]}
            >
              <h2 class="contents">
                <button
                  type="button"
                  data-collapse-most-used
                  aria-expanded="true"
                  class="focus-ring -m-1 mb-2 flex w-full items-center gap-2 rounded-md p-1 text-left hover:bg-surface/50"
                >
                  <ChevronDown size={16} class="shrink-0 text-ink-faint transition-transform" />
                  <span
                    class="grid h-8 w-8 shrink-0 place-items-center rounded-md"
                    style="color: var(--cat); background: color-mix(in srgb, var(--cat) 16%, transparent)"
                  >
                    <Sparkles size={16} />
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="block text-base font-semibold text-ink">Most Used</span>
                    <span data-most-used-count class="block text-xs text-ink-mute tabular-nums">
                      {mostUsedIds.length} {mostUsedIds.length === 1 ? "bookmark" : "bookmarks"}
                    </span>
                  </span>
                </button>
              </h2>
              <div data-most-used-body>
                <div data-category-grid class="grid grid-cols-1 gap-0" />
              </div>
            </section>

            <section
              data-favourites
              id="favourites"
              data-density="compact"
              class:list={[
                "scroll-mt-32 rounded-lg border border-edge bg-surface-2 p-4 shadow-card",
                favouriteCount === 0 && "hidden",
              ]}
            >
              <div class="mb-3 flex items-center gap-2">
                <span class="grid h-8 w-8 place-items-center rounded-md bg-accent-soft text-star">
                  <Star size={16} class="fill-star" />
                </span>
                <div>
                  <h2 class="text-base font-semibold text-ink">Favourites</h2>
                  <p data-favourites-count class="text-xs text-ink-mute tabular-nums">
                    {favouriteCount} {favouriteCount === 1 ? "bookmark" : "bookmarks"}
                  </p>
                </div>
              </div>
              <div data-category-grid class="grid grid-cols-1 gap-0" />
            </section>

            <div data-sections-container class="category-board">
              {collectionGroups.map((group) => (
                <Fragment>
                  {group.collection && (
                    <CollectionGroup
                      name={group.collection}
                      slug={group.slug}
                      count={group.count}
                      categories={group.categories}
                    />
                  )}
                  {!group.collection &&
                    group.categories.map((entry) => (
                      <CategorySection
                        category={entry.category}
                        displayName={entry.short}
                        count={entry.count}
                        hideWhenEmpty={entry.category.id === uncategorisedCategoryId}
                        deferred
                      />
                    ))}
                </Fragment>
              ))}

              <div data-new-category-row class="flex items-center">
                <button
                  type="button"
                  data-new-category-button
                  class="focus-ring inline-flex h-10 items-center gap-2 rounded-md border border-dashed border-edge-strong bg-surface px-4 text-sm font-medium text-ink-mute hover:border-accent hover:text-ink"
                >
                  <Plus size={16} />
                  New category
                </button>
                <form data-new-category-form class="hidden items-center gap-2">
                  <input
                    name="name"
                    required
                    placeholder="Category name"
                    autocomplete="off"
                    class="focus-ring h-10 w-56 rounded-md border border-edge-strong bg-surface px-3 text-sm"
                  />
                  <button
                    type="submit"
                    class="focus-ring inline-flex h-10 items-center gap-2 rounded-md bg-accent px-3 text-sm font-semibold text-accent-ink hover:bg-accent-strong"
                  >
                    Create
                  </button>
                  <button
                    type="button"
                    data-new-category-cancel
                    class="focus-ring inline-flex h-10 items-center rounded-md border border-edge bg-surface px-3 text-sm font-medium text-ink-mute hover:bg-surface-2"
                  >
                    Cancel
                  </button>
                </form>
              </div>
            </div>

            <div data-search-empty class="hidden">
              <EmptyState
                title="No matches found"
                message="Nothing matches your search. Try different words, or add it as a new bookmark."
              >
                <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
                  <button
                    type="button"
                    data-add-from-search
                    class="btn-vault focus-ring inline-flex h-10 max-w-[22rem] items-center gap-2 rounded-md px-4 text-sm"
                  >
                    <Plus size={16} class="shrink-0" />
                    <span class="min-w-0 truncate">Add “<span data-search-query></span>”</span>
                  </button>
                  <button
                    type="button"
                    data-search-clear
                    class="focus-ring inline-flex h-10 items-center gap-2 rounded-md border border-edge bg-surface px-4 text-sm font-medium text-ink-mute hover:border-edge-strong hover:text-ink"
                  >
                    Clear search
                  </button>
                </div>
              </EmptyState>
            </div>
          </div>
        </div>
      )
    }
  </main>

  <BookmarkDialog categories={categories} />
  <ConfirmDialog />
  <CommandPalette />
  <ShortcutCheatsheet />

  <!-- Toast region -->
  <div
    id="toast-region"
    class="pointer-events-none fixed inset-x-0 bottom-4 z-50 mx-auto flex w-[min(92vw,26rem)] flex-col gap-2"
    aria-live="polite"
  />

  <!-- Client-side templates -->
  <template id="bookmark-card-template">
    <BookmarkCard bookmark={emptyBookmark} />
  </template>
  <template id="category-section-template">
    <CategorySection category={emptyCategory} bookmarks={[]} />
  </template>

  <!-- Compact bookmark payload; cards are hydrated client-side from this. -->
  <script id="bookmark-data" type="application/json" set:html={bookmarkJson}></script>

  <!-- Ordered ids for the generated Most Used section (highest score first). -->
  <script id="most-used-data" type="application/json" set:html={mostUsedJson}></script>

  <script>
    import "../scripts/dashboard";
  </script>
</BaseLayout>
