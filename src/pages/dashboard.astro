---
import { FileUp, LayoutGrid, List, Plus, Star } from "@lucide/astro";
import BookmarkCard from "@components/BookmarkCard.astro";
import BookmarkDialog from "@components/BookmarkDialog.astro";
import CategorySection from "@components/CategorySection.astro";
import CommandPalette from "@components/CommandPalette.astro";
import ConfirmDialog from "@components/ConfirmDialog.astro";
import EmptyState from "@components/EmptyState.astro";
import ExportButton from "@components/ExportButton.astro";
import Header from "@components/Header.astro";
import ImportPanel from "@components/ImportPanel.astro";
import SearchBar from "@components/SearchBar.astro";
import ShortcutCheatsheet from "@components/ShortcutCheatsheet.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getPrivateUserId } from "@lib/auth";
import { listBookmarks } from "@lib/bookmarks";
import { listCategories } from "@lib/categories";
import { getDb, uncategorisedCategoryId } from "@lib/db";
import type { Bookmark, Category } from "@lib/types";

export const prerender = false;

const db = getDb();
const userId = getPrivateUserId();

const [categories, bookmarks] = await Promise.all([
  listCategories(db, userId),
  listBookmarks(db, userId),
]);

const groupedBookmarks = categories.map((category) => ({
  category,
  bookmarks: bookmarks
    .filter((bookmark) => bookmark.categoryId === category.id)
    .sort((a, b) => a.sortOrder - b.sortOrder || a.title.localeCompare(b.title)),
}));

const favourites = bookmarks.filter((bookmark) => bookmark.isFavourite).slice(0, 20);

const totalBookmarks = bookmarks.length;
const totalCategories = categories.length;

// Empty objects used only to stamp out client-side templates.
const emptyBookmark: Bookmark = {
  id: "",
  userId,
  categoryId: "",
  title: "",
  url: "",
  description: "",
  faviconUrl: undefined,
  sortOrder: 0,
  isFavourite: false,
  createdAt: "",
  updatedAt: "",
};
const emptyCategory: Category = {
  id: "",
  userId,
  name: "",
  slug: "",
  sortOrder: 0,
  createdAt: "",
  updatedAt: "",
};
---

<BaseLayout title="Dashboard" noindex>
  <Header active="dashboard" />

  <main
    class="mx-auto max-w-[100rem] px-4 py-6 sm:px-6 lg:px-8"
    data-uncategorised-id={uncategorisedCategoryId}
  >
    <section class="mb-5 flex flex-wrap items-center justify-between gap-3">
      <div>
        <h1 class="text-balance text-2xl font-semibold tracking-normal text-ink">My Bookmarks</h1>
        <p class="mt-1 text-sm text-ink-mute">
          <span data-visible-count class="tabular-nums">{totalBookmarks}</span> visible of
          <span data-total-count class="tabular-nums">{totalBookmarks}</span> bookmarks across
          <span data-category-total class="tabular-nums">{totalCategories}</span> categories.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <button
          type="button"
          data-open-add-bookmark
          class="focus-ring inline-flex h-10 items-center gap-2 rounded-md bg-accent px-3 text-sm font-semibold text-accent-ink shadow-sm hover:bg-accent-strong"
        >
          <Plus size={16} />
          Add Bookmark
        </button>
        <a
          href="/import"
          class="focus-ring inline-flex h-10 items-center gap-2 rounded-md border border-edge bg-surface px-3 text-sm font-medium text-ink-mute shadow-card hover:border-edge-strong hover:text-ink"
        >
          <FileUp size={16} />
          Import
        </a>
        <ExportButton format="json" />
        <ExportButton format="csv" />
        <button
          type="button"
          data-density-toggle
          aria-pressed="false"
          class="focus-ring grid h-10 w-10 place-items-center rounded-md border border-edge bg-surface text-ink-mute shadow-card hover:border-edge-strong hover:text-ink"
          title="Toggle density"
        >
          <LayoutGrid size={16} class="density-icon-grid" />
          <List size={16} class="density-icon-compact hidden" />
        </button>
      </div>
    </section>

    <section class="sticky top-0 z-20 -mx-4 border-y border-edge bg-canvas/95 px-4 py-4 backdrop-blur sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8">
      <SearchBar />
    </section>

    {
      totalBookmarks === 0 ? (
        <div class="mt-8 grid gap-6 lg:grid-cols-[minmax(0,1fr)_360px]">
          <EmptyState title="No bookmarks yet." message="Add your first bookmark, or import a Booky export to get started." >
            <button
              type="button"
              data-open-add-bookmark
              class="focus-ring mt-4 inline-flex h-10 items-center gap-2 rounded-md bg-accent px-4 text-sm font-semibold text-accent-ink hover:bg-accent-strong"
            >
              <Plus size={16} />
              Add a bookmark
            </button>
          </EmptyState>
          <ImportPanel />
        </div>
      ) : (
        <div class="mt-6 grid gap-6 lg:grid-cols-[220px_minmax(0,1fr)]">
          <aside class="hidden lg:block">
            <nav
              data-category-rail
              aria-label="Categories"
              class="sticky top-28 max-h-[calc(100vh-8rem)] overflow-y-auto pr-1 text-sm"
            >
              <p class="mb-2 px-2 text-xs font-semibold uppercase tracking-wide text-ink-faint">Categories</p>
              <div data-rail-list class="grid gap-0.5" />
            </nav>
          </aside>

          <div class="grid content-start gap-5">
            <section
              data-favourites
              data-density="compact"
              class:list={[
                "rounded-lg border border-edge bg-surface-2 p-4 shadow-card",
                favourites.length === 0 && "hidden",
              ]}
            >
              <div class="mb-3 flex items-center gap-2">
                <span class="grid h-8 w-8 place-items-center rounded-md bg-accent-soft text-star">
                  <Star size={16} class="fill-star" />
                </span>
                <div>
                  <h2 class="text-base font-semibold text-ink">Favourites</h2>
                  <p data-favourites-count class="text-xs text-ink-mute tabular-nums">
                    {favourites.length} {favourites.length === 1 ? "bookmark" : "bookmarks"}
                  </p>
                </div>
              </div>
              <div data-category-grid class="grid grid-cols-1 gap-0">
                {favourites.map((bookmark) => (
                  <BookmarkCard bookmark={bookmark} searchText="favourite" />
                ))}
              </div>
            </section>

            <div data-sections-container class="grid content-start gap-5">
              {groupedBookmarks.map(({ category, bookmarks }) => (
                <CategorySection category={category} bookmarks={bookmarks} />
              ))}

              <div data-new-category-row class="flex items-center">
                <button
                  type="button"
                  data-new-category-button
                  class="focus-ring inline-flex h-10 items-center gap-2 rounded-md border border-dashed border-edge-strong bg-surface px-4 text-sm font-medium text-ink-mute hover:border-accent hover:text-ink"
                >
                  <Plus size={16} />
                  New category
                </button>
                <form data-new-category-form class="hidden items-center gap-2">
                  <input
                    name="name"
                    required
                    placeholder="Category name"
                    autocomplete="off"
                    class="focus-ring h-10 w-56 rounded-md border border-edge-strong bg-surface px-3 text-sm"
                  />
                  <button
                    type="submit"
                    class="focus-ring inline-flex h-10 items-center gap-2 rounded-md bg-accent px-3 text-sm font-semibold text-accent-ink hover:bg-accent-strong"
                  >
                    Create
                  </button>
                  <button
                    type="button"
                    data-new-category-cancel
                    class="focus-ring inline-flex h-10 items-center rounded-md border border-edge bg-surface px-3 text-sm font-medium text-ink-mute hover:bg-surface-2"
                  >
                    Cancel
                  </button>
                </form>
              </div>
            </div>

            <div data-search-empty class="hidden">
              <EmptyState title="No bookmarks found." message="No bookmarks match this search.">
                <button
                  type="button"
                  data-add-from-search
                  class="focus-ring mt-4 inline-flex h-10 items-center gap-2 rounded-md bg-accent px-4 text-sm font-semibold text-accent-ink hover:bg-accent-strong"
                >
                  <Plus size={16} />
                  Add “<span data-search-query></span>” as a bookmark
                </button>
              </EmptyState>
            </div>
          </div>
        </div>
      )
    }
  </main>

  <BookmarkDialog categories={categories} />
  <ConfirmDialog />
  <CommandPalette />
  <ShortcutCheatsheet />

  <!-- Toast region -->
  <div
    id="toast-region"
    class="pointer-events-none fixed inset-x-0 bottom-4 z-50 mx-auto flex w-[min(92vw,26rem)] flex-col gap-2"
    aria-live="polite"
  />

  <!-- Client-side templates -->
  <template id="bookmark-card-template">
    <BookmarkCard bookmark={emptyBookmark} />
  </template>
  <template id="category-section-template">
    <CategorySection category={emptyCategory} bookmarks={[]} />
  </template>

  <script>
    import "../scripts/dashboard";
  </script>
</BaseLayout>
