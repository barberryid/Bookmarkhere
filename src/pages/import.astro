---
import { ArrowLeft } from "@lucide/astro";
import Header from "@components/Header.astro";
import ImportPanel from "@components/ImportPanel.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout title="Import" noindex>
  <Header active="dashboard" />
  <main class="mx-auto max-w-4xl px-4 py-8 sm:px-6 lg:px-8">
    <a href="/dashboard" class="focus-ring mb-6 inline-flex h-10 items-center gap-2 rounded-md border border-edge bg-surface px-3 text-sm font-medium text-ink-mute hover:border-edge-strong">
      <ArrowLeft size={16} />
      Dashboard
    </a>
    <ImportPanel />
  </main>
</BaseLayout>
