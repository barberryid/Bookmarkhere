---
import { ArrowRight, Check, Clock, Search } from "@lucide/astro";
import BookmarkCard from "@components/BookmarkCard.astro";
import Header from "@components/Header.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { bookmarks, groupedBookmarks } from "@lib/mockData";
import { productConfig } from "@lib/config";

const mockCards = bookmarks.slice(0, 5);
---

<BaseLayout title={productConfig.appName}>
  <Header active="home" />

  <main>
    <section class="relative isolate overflow-hidden border-b border-edge bg-accent-soft">
      <div class="pointer-events-none absolute inset-0 -z-10 opacity-55" aria-hidden="true" inert>
        <div class="mx-auto grid max-w-6xl grid-cols-1 gap-3 px-4 py-8 sm:grid-cols-2 lg:grid-cols-3">
          {mockCards.map((bookmark) => <BookmarkCard bookmark={bookmark} compact />)}
        </div>
      </div>
      <div class="absolute inset-0 -z-10 bg-accent-soft/80" aria-hidden="true"></div>

      <div class="mx-auto flex min-h-[68vh] max-w-7xl items-center px-4 py-20 sm:px-6 lg:px-8">
        <div class="max-w-2xl">
          <p class="mb-4 inline-flex rounded-md border border-edge-strong bg-surface/80 px-3 py-1 text-sm font-medium text-ink-mute">
            {productConfig.appName} · Personal bookmark manager
          </p>
          <h1 class="text-balance text-5xl font-semibold tracking-normal text-ink sm:text-6xl">
            Your bookmarks, cleanly organised.
          </h1>
          <p class="mt-5 max-w-xl text-xl leading-8 text-ink-mute">
            A fast, visual bookmark manager for keeping your favourite websites easy to find.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a
              href="/dashboard"
              class="focus-ring inline-flex h-11 items-center gap-2 rounded-md bg-accent px-5 text-sm font-semibold text-accent-ink shadow-sm transition hover:bg-accent-strong"
            >
              Open My Bookmarks
              <ArrowRight size={17} />
            </a>
            <a
              href="#mockup"
              class="focus-ring inline-flex h-11 items-center gap-2 rounded-md border border-edge-strong bg-surface/85 px-5 text-sm font-semibold text-ink-mute transition hover:border-accent"
            >
              <Search size={17} />
              View Layout
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="border-b border-edge bg-surface-2">
      <div class="mx-auto grid max-w-7xl gap-4 px-4 py-10 sm:grid-cols-3 sm:px-6 lg:px-8">
        <div class="rounded-lg border border-edge bg-surface p-5">
          <Check size={20} class="text-accent" />
          <h2 class="mt-3 text-base font-semibold">Folders first</h2>
          <p class="mt-2 text-sm leading-6 text-ink-mute">Categories stay visible, ordered, and easy to scan.</p>
        </div>
        <div class="rounded-lg border border-edge bg-surface p-5">
          <Search size={20} class="text-accent" />
          <h2 class="mt-3 text-base font-semibold">Search up top</h2>
          <p class="mt-2 text-sm leading-6 text-ink-mute">Find links by title, URL, description, or category — all from the keyboard.</p>
        </div>
        <div class="rounded-lg border border-edge bg-surface p-5">
          <Clock size={20} class="text-accent" />
          <h2 class="mt-3 text-base font-semibold">Built for speed</h2>
          <p class="mt-2 text-sm leading-6 text-ink-mute">Compact cards keep 500 to 5,000 bookmarks manageable.</p>
        </div>
      </div>
    </section>

    <section id="mockup" class="bg-canvas">
      <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
        <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
          <div>
            <h2 class="text-balance text-2xl font-semibold tracking-normal">Bookmark Cards</h2>
            <p class="mt-2 max-w-2xl text-sm leading-6 text-ink-mute">A screenshot-style view built from the same compact components used in the dashboard.</p>
          </div>
          <a href="/dashboard" class="focus-ring inline-flex h-10 items-center gap-2 rounded-md border border-edge-strong bg-surface px-4 text-sm font-semibold text-ink-mute hover:border-accent">
            Open Dashboard
            <ArrowRight size={16} />
          </a>
        </div>
        <div class="grid gap-4 lg:grid-cols-2">
          {groupedBookmarks.slice(0, 2).map(({ category, bookmarks }) => (
            <div class="rounded-lg border border-edge bg-surface-2 p-4">
              <h3 class="mb-3 text-sm font-semibold text-ink-mute">{category.name}</h3>
              <div class="grid gap-3">
                {bookmarks.slice(0, 2).map((bookmark) => <BookmarkCard bookmark={bookmark} compact />)}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="border-y border-edge bg-surface">
      <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
        <h2 class="text-balance text-2xl font-semibold tracking-normal">Built For Fast Bookmark Access</h2>
        <div class="mt-5 grid gap-4 text-sm leading-6 text-ink-mute md:grid-cols-3">
          <p>Import from Booky, keep folders, and skip duplicate URLs by default.</p>
          <p>Export JSON or CSV backups so the data remains portable.</p>
          <p>Start private now, with user IDs and subscription tables ready for a future paid beta.</p>
        </div>
      </div>
    </section>
  </main>

  <footer class="bg-ink px-4 py-8 text-sm text-canvas sm:px-6 lg:px-8">
    <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-3">
      <span>{productConfig.appName}</span>
      <span>Private MVP.</span>
    </div>
  </footer>
</BaseLayout>
